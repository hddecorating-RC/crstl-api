# Crstl API credentials (v2)
# Create keys at https://omnicrstl.web.app/api-keys (requires transactions:read scope)
CRSTL_API_KEY=ct_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base URL — keep /v2
CRSTL_BASE_URL=https://api.crstl.so/v2

# Pagination (optional)
CRSTL_PAGE_SIZE=100

# Set MOCK_DATA=true to run the dashboard with sample invoices (no Crstl key needed)
MOCK_DATA=false

# SCHEDULER_ENABLED — leave unset (or true) on the production host; set to
# false on dev workstations so a local `uvicorn --reload` doesn't fire cron
# jobs in parallel with the LXC (would produce duplicate digest emails).
# SCHEDULER_ENABLED=true

# Microsoft Graph mail sender (daily digest to accounting)
# Create an Azure AD app registration with Mail.Send Application permission
# and admin consent. See docs for setup steps.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=dashboards@hddecorating.com
MAIL_RECIPIENTS=accounting@hddecorating.com

# NetSuite Token-Based Auth (TBA) — for tools/push_invoices_to_netsuite.py --live.
# Left blank, the connector is unavailable and the CSV export path is used instead.
# From a NetSuite admin:
#   - an Integration record (Token-Based Auth enabled) gives CONSUMER_KEY/SECRET
#   - an Access Token (integration + user + a role that can create the record)
#     gives TOKEN_ID/SECRET
#   - a role needs "REST Web Services" + "Log in using Access Tokens" permissions
# NOTE: there is NO NetSuite sandbox for this account — these credentials WRITE to
# production. Test with a dry run, then a single invoice (--only), and delete it.
# Never commit real values; keep them only in .env / a secret store.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
