[Unit]
Description=CRSTL Finale worker (15-min Finale invoicing poll + warehouse pre-fill)
Documentation=https://github.com/hddecorating-RC/crstl-api
After=network-online.target crstl-api.service
Wants=network-online.target

[Service]
Type=simple
User=crstl
Group=crstl
WorkingDirectory=/opt/crstl-api
EnvironmentFile=/opt/crstl-api/.env
Environment="TZ=America/Toronto"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/crstl-api/.venv/bin/python -m app.worker finale
# Exits 1 while another process still schedules its job (e.g. crstl-api before its
# SCHEDULER_JOBS was narrowed); systemd retries until it can take it over.
Restart=on-failure
RestartSec=30s
# SIGTERM waits for a running job to finish; a Finale poll takes ~1-2 min, so allow 5 before a kill.
TimeoutStopSec=300s
StandardOutput=journal
StandardError=journal

# Same hardening as crstl-api -- .tmp (tracking.db, lock files) is the only writable path.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/crstl-api/.tmp

[Install]
WantedBy=multi-user.target
